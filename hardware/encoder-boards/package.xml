<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>encoder_boards</name>
  <version>0.0.0</version>
  <description>
    Arm encoder CAN frame decoder and telemetry node for TLE5012B boards
    (Base, Shoulder, Elbow, Wrist).
  </description>
  <maintainer email="michael.lythgoe@spaceconcordia.ca">mike</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>can_util</depend>
  <depend>ros2_fmt_logger</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
