<?xml version="1.0"?>
<!--
  Fake ros2_control block for MoveIt planning demos (no CAN / serial hardware).
  Uses mock_components/GenericSystem so both controllers used by
  arm_ik_teleop.launch.py work in RViz:
    - arm_trajectory_controller commands POSITION (move_group Plan & Execute)
    - arm_servo_controller commands VELOCITY (MoveIt Servo FK / Cartesian teleop)
  calculate_dynamics integrates commanded velocity into the position state so the
  model visibly moves under servo teleop, not just trajectory execution.
  joint1-6 are the SRDF "arm" planning group (driven by arm_servo_controller /
  arm_trajectory_controller). joint7 (gripper) is outside the planning group and
  is driven directly by gripper_controller; it is declared here so the gripper is
  commandable in sim. joint7 is a movable joint in the URDF because GenericSystem
  rejects fixed joints.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rover_arm_fake_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
                <param name="calculate_dynamics">true</param>
            </hardware>

            <xacro:macro name="fake_arm_joint" params="joint_name">
                <joint name="${joint_name}">
                    <command_interface name="position"/>
                    <command_interface name="velocity"/>
                    <state_interface name="position">
                        <param name="initial_value">${initial_positions[joint_name]}</param>
                    </state_interface>
                    <state_interface name="velocity"/>
                </joint>
            </xacro:macro>

            <xacro:fake_arm_joint joint_name="joint1"/>
            <xacro:fake_arm_joint joint_name="joint2"/>
            <xacro:fake_arm_joint joint_name="joint3"/>
            <xacro:fake_arm_joint joint_name="joint4"/>
            <xacro:fake_arm_joint joint_name="joint5"/>
            <xacro:fake_arm_joint joint_name="joint6"/>
            <xacro:fake_arm_joint joint_name="joint7"/>
        </ros2_control>
    </xacro:macro>
</robot>
