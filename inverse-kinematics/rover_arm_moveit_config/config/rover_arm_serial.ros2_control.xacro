<?xml version="1.0"?>
<!--
  LEGACY serial ros2_control block for the rover arm (arm_interface/ArmInterface):
  ABSENC encoders on /dev/ttyUSB0 and motor commands on /dev/ttyTHS1.

  Kept for reference only. The arm has moved to CAN; production uses
  arm_can_hardware/ArmCanInterface via rover_arm_can.ros2_control.xacro.
  Select this path with hardware_backend:=serial in rover_arm.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rover_arm_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

       <ros2_control name="RoverArm" type="system">
          <hardware>
            <plugin>arm_interface/ArmInterface</plugin>
          </hardware>

            <!-- Note: RVIZ only takes positional command interfaces, so when using this interface on the real arm 
              one can simply comment out or remove the position command interfaces.-->
            <joint name="joint1">
                <command_interface name="velocity"/>
                <!-- <command_interface name="position"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint2">
                <command_interface name="velocity"/>
                <!-- <command_interface name="position"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint3">
                <command_interface name="velocity"/>
                <!-- <command_interface name="position"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint5">
                <command_interface name="velocity"/>
                <!-- <command_interface name="position"/> -->
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
